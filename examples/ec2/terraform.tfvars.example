#################################################
# Infrastructure
#################################################

project = "terraform-aws-platform"

environment = "dev"

#################################################
# EC2 Configuration
#################################################

ami_id = "ami-0123456789abcdef0"

instance_type = "t3.micro"

subnet_id = "subnet-0123456789abcdef0"

security_group_ids = [
  "sg-0123456789abcdef0"
]

instance_profile = "ec2-instance-profile"

key_pair = "terraform-key"

#################################################
# Tags
#################################################

tags = {
  ManagedBy = "Terraform"
  Owner     = "Platform Team"
}
